{
  "name": "shapewise",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@shapewise/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "gen:indexes": "pnpm --filter @shapewise/db gen:indexes",
    "emulators": "firebase emulators:start --project demo-shapewise"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
